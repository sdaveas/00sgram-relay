# Copy to .env. Never commit .env.
# Comments stay on their own lines: docker env_file does not reliably strip
# trailing comments.

# The app from inside the compose network. Its compose project is `00sgram_default`.
API_URL=http://web:8080
# The app's own header pair, not OAuth: the relay sends it as x-api-token.
# `python3 -c "import secrets;print(secrets.token_urlsafe(32))"` in the app's .env.
API_TOKEN=

# Bot token from @BotFather. No token = nothing to talk to.
TELEGRAM_TOKEN=
# The one forum group the relay speaks in (negative id, e.g. -1001234567890).
# Topic ids are per group, so this is the relay's whole address space.
TELEGRAM_RELAY_CHAT=

# The relay's own SQLite. A new path is a fresh install: it adopts the inbox and
# makes new topics. Point it at an existing file to keep the mapping.
RELAY_DB=/data/relay.sqlite3
# Seconds between inbox passes. The Bot API is polled continuously; this is how
# often the app is asked what changed.
RELAY_INTERVAL=20
